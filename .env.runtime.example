# Production runtime ONLY. DO NOT include DATABASE_URL, the migration/owner credential.
APP_ORIGIN="https://school.example.org"
# Fail-closed on public deployments until database and privacy acceptance tests pass.
SCHOOL_LIVE_READY=false
DATABASE_URL_MEN="postgresql://shams_men_login:REPLACE@db-host:5432/shams_alkhair?schema=hifz_men"
DATABASE_URL_WOMEN="postgresql://shams_women_login:REPLACE@db-host:5432/shams_alkhair?schema=hifz_women"
DATABASE_URL_ACADEMY="postgresql://shams_academy_login:REPLACE@db-host:5432/shams_alkhair?schema=academy"
DATABASE_URL_CONTACT="postgresql://shams_contact_login:REPLACE@db-host:5432/shams_alkhair?schema=core"
SCHOOL_WHATSAPP=""
SCHOOL_ADDRESS=""
SCHOOL_MAP_URL=""

# PHASE 2: no schema-owner privileges in any of these 4 runtime URLs.
DATABASE_URL_AUTH="postgresql://shams_auth_login:REPLACE@db-host:5432/shams_alkhair?schema=core"
DATABASE_URL_STAFF_MEN="postgresql://shams_staff_men_login:REPLACE@db-host:5432/shams_alkhair?schema=hifz_men"
DATABASE_URL_STAFF_WOMEN="postgresql://shams_staff_women_login:REPLACE@db-host:5432/shams_alkhair?schema=hifz_women"
DATABASE_URL_STAFF_ACADEMY="postgresql://shams_staff_academy_login:REPLACE@db-host:5432/shams_alkhair?schema=academy"

# Phase 3 (do not paste production secrets into source control)
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
RESEND_API_KEY=
REPORT_EMAIL_FROM=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PHASE 4: Quran Foundation Content API. Follow provider's access/token guidelines.
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_TOKEN=
# Must be selected from /resources/recitations (ayah-by-ayah IDs), not chapter reciters.
QURAN_REFERENCE_RECITATION_ID=
# Independent PRIVATE S3-compatible buckets; NEVER configure public access.
RECITATION_BUCKET_MEN=shams-recitation-men
RECITATION_BUCKET_WOMEN=shams-recitation-women
RECITATION_BUCKET_ACADEMY=shams-recitation-academy
RECITATION_S3_REGION=eu-central-1
RECITATION_S3_ENDPOINT=
RECITATION_S3_PATH_STYLE=false
RECITATION_S3_ACCESS_KEY_MEN=
RECITATION_S3_SECRET_KEY_MEN=
RECITATION_S3_ACCESS_KEY_WOMEN=
RECITATION_S3_SECRET_KEY_WOMEN=
RECITATION_S3_ACCESS_KEY_ACADEMY=
RECITATION_S3_SECRET_KEY_ACADEMY=
RECITATION_S3_SSE_KMS_KEY=
# An INTERNAL / approved ASR endpoint. Do not send minors' data to external providers without consent and agreements.
RECITATION_ASR_URL=http://asr:8000/transcribe
RECITATION_ASR_TOKEN=
RECITATION_ASR_WOMEN_APPROVED=false
# Only the trusted scheduler knows this, not the browser.
RECITATION_JOB_SECRET=

# Stage 5: dedicated Stream accounts/tokens/customer codes PER scope. Never NEXT_PUBLIC_!
# To prevent mixed access, account IDs MUST be different in production.
VIDEO_CF_ACCOUNT_MEN=account_men_here
VIDEO_CF_TOKEN_MEN=secret_men_here
VIDEO_CF_CUSTOMER_MEN=customer-examplemen
VIDEO_CF_WEBHOOK_MEN=secret_webhook_men_here
VIDEO_CF_ACCOUNT_WOMEN=account_women_here
VIDEO_CF_TOKEN_WOMEN=secret_women_here
VIDEO_CF_CUSTOMER_WOMEN=customer-examplewomen
VIDEO_CF_WEBHOOK_WOMEN=secret_webhook_women_here
VIDEO_CF_ACCOUNT_ACADEMY=account_academy_here
VIDEO_CF_TOKEN_ACADEMY=secret_academy_here
VIDEO_CF_CUSTOMER_ACADEMY=customer-exampleacademy
VIDEO_CF_WEBHOOK_ACADEMY=secret_webhook_academy_here

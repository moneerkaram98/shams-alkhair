# Development only: schema owner, used by Prisma CLI and local seed. NEVER deploy it with public app.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/shams_alkhair?schema=core"
# Runtime accounts must be different DB logins with separate GRANTs. See db/roles.sql.
DATABASE_URL_MEN="postgresql://shams_men_login:CHANGE_ME@localhost:5432/shams_alkhair?schema=hifz_men"
DATABASE_URL_WOMEN="postgresql://shams_women_login:CHANGE_ME@localhost:5432/shams_alkhair?schema=hifz_women"
DATABASE_URL_ACADEMY="postgresql://shams_academy_login:CHANGE_ME@localhost:5432/shams_alkhair?schema=academy"
APP_ORIGIN="http://localhost:3000"

# Public contact form has INSERT only to core.ContactInquiry.
DATABASE_URL_CONTACT="postgresql://shams_contact_login:CHANGE_ME@localhost:5432/shams_alkhair?schema=core"
# Show contact information only if verified as belonging to the school.
SCHOOL_WHATSAPP=""
SCHOOL_ADDRESS=""
SCHOOL_MAP_URL=""

# Enable local-only staff CLI with explicit acknowledgement; never use on production.
ENABLE_LOCAL_STAFF_CLI="no"
ALLOW_WOMEN_STAFF_DEV="no"
ALLOW_CONTACT_STAFF_DEV="no"

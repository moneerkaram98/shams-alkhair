/// Phase 3: progress is always private to this scope. Scores indicate teacher judgment, not AI grading.
model MenLearningRecord {
 id String @id @default(uuid()) @db.Uuid
 studentId String @db.Uuid
 groupId String @db.Uuid
 teacherId String @db.Uuid
 activity String // NEW_MEMORIZATION | REVIEW
 surahNumber Int
 ayahFrom Int
 ayahTo Int
 mastery Int // 0..100; constraints-stage3.sql enforces bounds
 memoryErrors Int @default(0)
 tajweedErrors Int @default(0)
 makharijErrors Int @default(0)
 teacherNote String?
 assessedAt DateTime @default(now())
 createdAt DateTime @default(now())
 student MenStudent @relation(fields:[studentId],references:[id],onDelete:Restrict)
 @@index([studentId, assessedAt])
 @@index([groupId, assessedAt])
 @@schema("hifz_men")
}

model MenStudentReport {
 id String @id @default(uuid()) @db.Uuid
 studentId String @db.Uuid
 periodType String // WEEKLY | MONTHLY
 periodStart DateTime @db.Date
 periodEnd DateTime @db.Date // exclusive
 status String @default("DRAFT") // DRAFT | PUBLISHED
 snapshot Json
 teacherComment String?
 generatedBy String? @db.Uuid
 approvedBy String? @db.Uuid
 publishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 student MenStudent @relation(fields:[studentId],references:[id],onDelete:Restrict)
 deliveries MenReportDelivery[]
 @@unique([studentId, periodType, periodStart])
 @@index([status,periodStart])
 @@schema("hifz_men")
}

model MenReportPreference {
 id String @id @default(uuid()) @db.Uuid
 studentId String @db.Uuid
 guardianUserId String @db.Uuid
 weekly Boolean @default(true)
 monthly Boolean @default(true)
 inApp Boolean @default(true)
 email Boolean @default(false)
 whatsapp Boolean @default(false) // reserved until verified opt-in/template setup
 requireTeacherApproval Boolean @default(true)
 emailOptInAt DateTime?
 whatsappOptInAt DateTime?
 updatedAt DateTime @updatedAt
 student MenStudent @relation(fields:[studentId],references:[id],onDelete:Restrict)
 @@unique([studentId,guardianUserId])
 @@index([guardianUserId])
 @@schema("hifz_men")
}

model MenReportDelivery {
 id String @id @default(uuid()) @db.Uuid
 reportId String @db.Uuid
 guardianUserId String @db.Uuid
 method String // IN_APP | EMAIL
 status String @default("QUEUED") // QUEUED | SENT | FAILED
 attempts Int @default(0)
 processingAt DateTime?
 providerId String?
 lastError String?
 deliveredAt DateTime?
 createdAt DateTime @default(now())

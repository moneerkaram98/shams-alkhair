generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "hifz_men", "hifz_women", "academy"]
}

/// Public/reference data and administrative access. No female-student profiles in core.
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameAr    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@schema("core")
}

model Department {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  nameAr    String
  programs  Program[]
  createdAt DateTime  @default(now())

  @@schema("core")
}

model Program {
  id           String     @id @default(uuid()) @db.Uuid
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  code         String     @unique
  nameAr       String
  active       Boolean    @default(true)
  levels       Level[]

  @@index([departmentId])
  @@schema("core")
}

model Level {
  id        String  @id @default(uuid()) @db.Uuid
  programId String  @db.Uuid
  program   Program @relation(fields: [programId], references: [id])
  nameAr    String
  order     Int

  @@unique([programId, order])
  @@schema("core")
}

/// Identity and authorization scaffolding; the auth/login UI comes in Phase 2.
model AppUser {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique
  displayName  String           @default("User")
  gender       String           @default("UNSPECIFIED")
  passwordHash String?
  failedLogins Int              @default(0)
  lockedUntil  DateTime?
  sessions     AuthSession[]
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  roles        RoleAssignment[]
  requested    SensitiveAccessGrant[] @relation("GrantRequester")
  approved     SensitiveAccessGrant[] @relation("GrantApprover")

  @@schema("core")
}

model AccessScope {
  id         String                 @id @default(uuid()) @db.Uuid
  code       String                 @unique
  nameAr     String
  roles      RoleAssignment[]
  grants     SensitiveAccessGrant[]

  @@schema("core")
}

model RoleAssignment {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  scopeId   String      @db.Uuid
  role      String
  active    Boolean     @default(true)
  validFrom DateTime    @default(now())
  validTo   DateTime?
  user      AppUser     @relation(fields: [userId], references: [id])
  scope     AccessScope @relation(fields: [scopeId], references: [id])

  @@unique([userId, scopeId, role])
  @@index([scopeId, role])
  @@schema("core")
}

/// A supervisor-approved, expiring grant; manager cannot approve their own request.
model SensitiveAccessGrant {
  id          String      @id @default(uuid()) @db.Uuid
  requesterId String      @db.Uuid
  approverId  String?     @db.Uuid
  scopeId     String      @db.Uuid
  purpose     String
  requestedAt DateTime    @default(now())
  approvedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  requester   AppUser     @relation("GrantRequester", fields: [requesterId], references: [id])
  approver    AppUser?    @relation("GrantApprover", fields: [approverId], references: [id])
  scope       AccessScope @relation(fields: [scopeId], references: [id])

  @@index([scopeId, requesterId, expiresAt])
  @@schema("core")
}

/// Append-only operational record; enforce immutability in database privileges/triggers.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @db.Uuid
  action      String
  scopeCode   String
  subjectType String
  subjectId   String?
  reason      String?
  occurredAt  DateTime @default(now())
  metadata    Json?

  @@index([scopeCode, occurredAt])
  @@schema("core")
}

/// Private admissions for hifz_men; not stored in core.
model MenApplication {
  id                 String                  @id @default(uuid()) @db.Uuid
  reference          String                  @unique
  accessTokenHash    String                  @unique
  fullName           String
  birthDate          DateTime                @db.Date
  gender             String
  phone              String
  email              String?
  guardianName       String?
  guardianPhone      String?
  guardianEmail      String?
  programCode String  @default("HIFZ")
  notes              String?
  status             String                  @default("PENDING")
  consentVersion     String
  privacyConsentAt   DateTime
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  bookings           MenPlacementBooking[]

  @@index([status, createdAt])
  @@schema("hifz_men")
}

model MenPlacementSlot {
  id          String                     @id @default(uuid()) @db.Uuid
  startsAt    DateTime
  durationMin Int                        @default(30)
  capacity    Int                        @default(10)
  locationAr  String
  active      Boolean                    @default(true)
  bookings    MenPlacementBooking[]

  @@index([startsAt, active])
  @@schema("hifz_men")
}

model MenPlacementBooking {
  id            String                  @id @default(uuid()) @db.Uuid
  applicationId String                  @unique @db.Uuid
  slotId        String                  @db.Uuid
  status        String                  @default("BOOKED")
  bookedAt      DateTime                @default(now())
  application   MenApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  slot          MenPlacementSlot    @relation(fields: [slotId], references: [id], onDelete: Restrict)
  result        MenPlacementResult?

  @@index([slotId])
  @@schema("hifz_men")
}

model MenPlacementResult {
  id               String                  @id @default(uuid()) @db.Uuid
  bookingId        String                  @unique @db.Uuid
  score            Int?
  recommendedLevel String?
  passed           Boolean?
  teacherNotes     String?
  evaluatedAt      DateTime                @default(now())
  booking          MenPlacementBooking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@schema("hifz_men")
}


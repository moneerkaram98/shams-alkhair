{
  "name": "shams-alkhair-integration",
  "version": "6.3.0-preflight",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "staff": "node scripts/staff-dev.mjs",
    "test:smoke": "node scripts/smoke-api.mjs",
    "test:contracts": "node --test tests/*.test.mjs",
    "staff:create-user": "node scripts/phase2-staff.mjs",
    "test:security": "node --test tests/phase2.security.test.mjs",
    "test:phase2:e2e": "node scripts/phase2-smoke.mjs",
    "test:phase3": "node --test tests/phase3.contract.test.mjs",
    "test:phase3:e2e": "node scripts/phase3-smoke.mjs",
    "test:phase4": "node --test tests/phase4.alignment.test.mjs tests/phase4.security.test.mjs",
    "test:stage4:e2e": "node scripts/phase4-smoke.mjs",
    "test:phase5": "node --test tests/phase5.policy.test.mjs tests/phase5.security.test.mjs",
    "test:stage5:e2e": "node scripts/phase5-smoke.mjs",
    "test:phase6": "node --test tests/phase6.logic.test.mjs tests/phase6.security.test.mjs",
    "test:stage6:e2e": "node scripts/phase6-smoke.mjs",
    "verify:offline": "node scripts/verify-integration.mjs && node --test tests/*.test.mjs",
    "verify:strict": "node scripts/verify-integration.mjs --strict",
    "verify:db-isolation": "node scripts/verify-db-isolation.mjs",
    "verify:release": "node scripts/release-safety.mjs"
  },
  "dependencies": {
    "next": "~16.0.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "@prisma/client": "~6.19.0",
    "zod": "~3.25.0",
    "server-only": "0.0.1",
    "qrcode": "^1.5.4",
    "@zxing/browser": "^0.1.5",
    "@aws-sdk/client-s3": "^3.900.0"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/node": "~22.0.0",
    "prisma": "~6.19.0",
    "dotenv": "~16.6.0",
    "@types/qrcode": "^1.5.5"
  }
}
